{
	"root": true,
	"env": {
		"es2021": true,
		"node": true
	},
	"extends": [
		//"airbnb-base",
		"eslint:recommended",
		"plugin:@typescript-eslint/eslint-recommended",
		"plugin:@typescript-eslint/recommended",
		"plugin:prettier/recommended",
		"prettier"
	],
	"parser": "@typescript-eslint/parser",
	"parserOptions": {
		"ecmaVersion": 12,
		"sourceType": "module"
	},
	"plugins": ["@typescript-eslint", "no-loops"],
	"rules": {
		"no-console": 2,
		"no-loops/no-loops": 2,
		"indent": ["error", "tab"],
		"prettier/prettier": [2, { "useTabs": true }]
	},
	"settings": {
		"import/resolver": {
			"node": {
				"extensions": [".js", ".d.ts", ".ts"],
				"moduleDirectory": ["node_modules", "src/"]
			}
		}
	}
}
